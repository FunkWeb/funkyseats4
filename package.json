{
  "name": "funkyseats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env backend/src/server.ts & vite",
    "dev:db-up": "docker compose -f docker-compose.dev.yml up --build -d --wait",
    "dev:db-down": "docker compose -f docker-compose.dev.yml down",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/backend/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:frontend": "vite build",
    "test:integration": "tsx --env-file-if-exists=.env --test \"backend/tests/integration/**/*.test.ts\"",
    "test": "tsx --env-file-if-exists=.env --test \"backend/src/**/*.test.ts\"",
    "migrate": "tsx --env-file=.env backend/src/database/migration-runner/migrationCli.ts",
    "migrate:down": "npm run migrate -- down",
    "migrate:status": "npm run migrate -- status"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.4"
  }
}
