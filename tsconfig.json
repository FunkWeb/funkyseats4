{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@contracts/*": ["./contracts/*"]
    }
  },
  "include": ["backend", "frontend", "contracts"]
}
